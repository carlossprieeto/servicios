//
// Do any local configuration here
//

// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";

/////////////////////////////////////////////////7
// CONFIGURACION DNS
/////////////////////////////////////////////////

//ZONA BUSQUEDA DIRECTA
zone "dominio.org"
{
    type master;
    file "/etc/bind/e1j/db.dominio.org";
    allow-query { 2.4.6.0/24;};
    allow-transfer { 2.4.6.4;};
    also-notify { 2.4.6.4;};
};


//ZONA BUSQUEDA INVERSA PONER IP AL REVES!!!!!
zone "6.4.2.in-addr.arpa"
{
    type master;
    file "/etc/bind/e1j/db.2.4.6";
    allow-query { 2.4.6.0/24;};
    allow-transfer { 2.4.6.4;};
    also-notify { 2.4.6.4;};

};


/////////////////////////////////////////////////

/////////////////////////////////////////////////

//ZONA BUSQUEDA DIRECTA
zone "subdominio1.dominio.org"
{
    type master;
    file "/etc/bind/e1j/db.subdominio1.dominio.org";
    allow-query { 2.4.6.0/24; 1.3.5.0/24;};
    allow-transfer { 2.4.6.4;};
    also-notify { 2.4.6.4;};
};


//ZONA BUSQUEDA INVERSA PONER IP AL REVES!!!!!
