//
// Do any local configuration here
//

// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";

/////////////////////////////////////////////////7
// CONFIGURACION DNS
/////////////////////////////////////////////////

//ZONA BUSQUEDA DIRECTA
zone "dnsalfa.net"
{
    type master;
    file "/etc/bind/e1j/db.dnsalfa.net";
    allow-query {127.0.0.1; 192.168.229.0/24;};
};


//ZONA BUSQUEDA INVERSA PONER IP AL REVES!!!!!
zone "229.168.192.in-addr.arpa"
{
    type master;
    file "/etc/bind/e1j/db.192.168.229";
    allow-query {127.0.0.1; 192.168.229.0/24;};
};


/////////////////////////////////////////////////

//ZONA BUSQUEDA DIRECTA
zone "dnsbeta.org"
{
    type master;
    file "/etc/bind/e1j/db.dnsbeta.org";
    allow-query {127.0.0.1; 175.185.229.0/24;};
};


//ZONA BUSQUEDA INVERSA PONER IP AL REVES!!
zone "229.185.175.in-addr.arpa"
{
    type master;
    file "/etc/bind/e1j/db.175.185.229";
    allow-query {127.0.0.1; 175.185.229.0/24;};
};
