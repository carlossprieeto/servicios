/////////////////////////////////////////////////7
// CONFIGURACION DNS
/////////////////////////////////////////////////

//ZONA BUSQUEDA DIRECTA
zone "dominio.org"
{
    type slave;
    file "/etc/bind/zonas/db.dominio.org";
    masters {2.4.6.8;};
    allow-query { 2.4.6.0/24;};
};


//ZONA BUSQUEDA INVERSA PONER IP AL REVES!!!!!
zone "6.4.2.in-addr.arpa"
{
    type slave;
    file "/etc/bind/zonas/db.2.4.6";
    masters {2.4.6.8;};
    allow-query { 2.4.6.0/24;};

};


/////////////////////////////////////////////////


/////////////////////////////////////////////////

//ZONA BUSQUEDA DIRECTA
zone "subdominio1.dominio.org"
{
    type slave;
    file "/etc/bind/zonas/db.subdominio1.dominio.org";
    masters {2.4.6.8;};
    allow-query { 2.4.6.0/24; 1.3.5.0/24;};
};


//ZONA BUSQUEDA INVERSA PONER IP AL REVES!!!!!
zone "5.3.1.in-addr.arpa"
{
    type slave;
    file "/etc/bind/zonas/db.1.3.5";
    masters {2.4.6.8;};
    allow-query { 2.4.6.0/24; 1.3.5.0/24;};

};


/////////////////////////////////////////////////



/////////////////////////////////////////////////

