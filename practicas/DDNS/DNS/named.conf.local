//
// Do any local configuration here
//

// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";

/////////////////////////////////////////////////7
// CONFIGURACION DNS
/////////////////////////////////////////////////

//ZONA BUSQUEDA DIRECTA
zone "empresa.org"
{
    type master;
    file "/etc/bind/ddns/db.empresa.org";
    allow-query {127.0.0.1; 11.110.120.0/24;};
    allow-update { key "rndc-key";};
    notify yes;
};


//ZONA BUSQUEDA INVERSA PONER IP AL REVES!!!!!
zone "120.110.11.in-addr.arpa"
{
    type master;
    file "/etc/bind/ddns/db.11.110.120";
    allow-query {127.0.0.1; 11.110.120.0/24;};
    allow-update { key "rndc-key";};
    notify yes;

};


/////////////////////////////////////////////////

