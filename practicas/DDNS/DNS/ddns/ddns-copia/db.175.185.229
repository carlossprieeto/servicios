			 604800 )	; Negative Cache TTL

;REGISTROS TIPO NS. Declaracion del SERVER-DNS
@	IN	NS	servernix1.dnsbeta.org.

;REGISTROS TIPO PTR. Declaracion de HOSTS.
200	IN	PTR	servernix1.dnsbeta.org.
