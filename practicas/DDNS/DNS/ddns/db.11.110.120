;
; BIND reverse data file for local loopback interface
;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; FICHERO DE BUSQUEDA INVERSA: db.192.168.229
;;;;;;;;;;ABAJO LA IP AL REVES!;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

$TTL	604800
@	IN	SOA	120.110.11.in-addr.arpa. admin.yahoo.es. (
			      1		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL

;REGISTROS TIPO NS. Declaracion del SERVER-DNS
@	IN	NS	serverddns.empresa.org.

;REGISTROS TIPO PTR. Declaracion de HOSTS - DECLARAR SERVIDOR TAMBIEN.
250	IN	PTR	serverddns.empresa.org.
